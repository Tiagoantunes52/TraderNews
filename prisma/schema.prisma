generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String        @id @default(cuid())
  clerkId         String        @unique
  email           String?       @unique
  role            Role          @default(USER)
  alertEmails     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  userStocks      UserStock[]
  userMarkets     UserMarket[]
  invitationsSent Invitation[]  @relation("InvitedBy")
  invitationUsed  Invitation?   @relation("AcceptedBy")
}

model Invitation {
  id                String    @id @default(cuid())
  email             String    @unique
  invitedBy         User      @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById       String
  acceptedAt        DateTime?
  acceptedBy        User?     @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])
  acceptedByUserId  String?   @unique
  clerkInvitationId String?   @unique
  createdAt         DateTime  @default(now())

  @@index([email])
}

model Market {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  stocks      Stock[]
  userMarkets UserMarket[]
}

model Stock {
  id             String          @id @default(cuid())
  ticker         String          @unique
  name           String
  market         Market          @relation(fields: [marketId], references: [id])
  marketId       String
  articleStock   ArticleStock[]
  sentiments     Sentiment[]
  quantAnalyses  QuantAnalysis[]
  stockEstimates StockEstimate[]
  alerts         Alert[]
  etfProfile     EtfProfile?
  userStocks     UserStock[]
}

model Article {
  id           String         @id @default(cuid())
  headline     String
  summary      String?
  url          String         @unique
  source       String
  publishedAt  DateTime
  createdAt    DateTime       @default(now())
  articleStock ArticleStock[]
}

model ArticleStock {
  id             String  @id @default(cuid())
  article        Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId      String
  stock          Stock   @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId        String
  sentimentScore Float?

  @@unique([articleId, stockId])
}

model Sentiment {
  id                 String   @id @default(cuid())
  stock              Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId            String
  score              Float
  summary            String?
  confidence         Float?
  keyDriver          String?
  aspects            Json?
  articleCount       Int      @default(0)
  avgArticleAgeHours Float?
  date               DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([stockId, date])
}

model QuantAnalysis {
  id             String   @id @default(cuid())
  stock          Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId        String
  price          Float?
  change1d       Float?
  change7d       Float?
  change30d      Float?
  rsi14          Float?
  sma20          Float?
  sma50          Float?
  volatility30d  Float?
  volumeRatio10d Float?
  macdHistogram  Float?
  priceVs60dHigh Float?
  priceVs60dLow  Float?
  relativeStr7d       Float?
  bollingerWidth      Float?
  bollingerPctB       Float?
  atr14               Float?
  atrPct              Float?
  nextEarningsDate    DateTime?
  daysToEarnings      Int?
  relativeStrSector7d Float?
  score               Float
  date                DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([stockId, date])
}

model StockEstimate {
  id                   String   @id @default(cuid())
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId              String
  sentimentScore       Float
  quantScore           Float?
  combinedScore        Float
  signal               String
  confidence           Float    @default(0.5)
  dataWarnings         String[]
  sentimentDelta       Float?
  articleVelocityRatio Float?
  date                 DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([stockId, date])
}

model Alert {
  id        String   @id @default(cuid())
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId   String
  type      String // SIGNAL_CHANGE | VELOCITY_SPIKE | RSI_EXTREME
  title     String
  message   String
  value     Float?
  createdAt DateTime @default(now())

  @@index([stockId, createdAt])
}

model EtfProfile {
  id            String    @id @default(cuid())
  stock         Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId       String    @unique
  netAssets     Float?
  expenseRatio  Float?
  dividendYield Float?
  inceptionDate DateTime?
  sectors       Json? // [{ sector, weight }]
  holdings      Json? // [{ symbol, description, weight }]
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

model UserStock {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String

  @@unique([userId, stockId])
}

model UserMarket {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  marketId String

  @@unique([userId, marketId])
}
