generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String       @id @default(cuid())
  clerkId         String       @unique
  email           String?      @unique
  role            Role         @default(USER)
  alertEmails     Boolean      @default(true)
  createdAt       DateTime     @default(now())
  userStocks      UserStock[]
  userMarkets     UserMarket[]
  invitationsSent Invitation[] @relation("InvitedBy")
  invitationUsed  Invitation?  @relation("AcceptedBy")
}

model Invitation {
  id                String    @id @default(cuid())
  email             String    @unique
  invitedBy         User      @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById       String
  acceptedAt        DateTime?
  acceptedBy        User?     @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])
  acceptedByUserId  String?   @unique
  clerkInvitationId String?   @unique
  createdAt         DateTime  @default(now())

  @@index([email])
  @@index([invitedById])
}

model Market {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  stocks      Stock[]
  userMarkets UserMarket[]
}

model Stock {
  id                  String               @id @default(cuid())
  ticker              String               @unique
  name                String
  market              Market               @relation(fields: [marketId], references: [id])
  marketId            String
  articleStock        ArticleStock[]
  sentiments          Sentiment[]
  quantAnalyses       QuantAnalysis[]
  stockEstimates      StockEstimate[]
  alerts              Alert[]
  etfProfile          EtfProfile?
  insiderTransactions InsiderTransaction[]
  insiderSummaries    InsiderSummary[]
  congressTrades      CongressTrade[]
  paperOrders         PaperOrder[]
  simPositions        SimPosition[]
  priceBars           PriceBar[]
  universeSnapshots   UniverseSnapshot[]
  userStocks          UserStock[]

  @@index([marketId])
}

model Article {
  id           String         @id @default(cuid())
  headline     String
  summary      String?
  url          String         @unique
  source       String
  publishedAt  DateTime
  createdAt    DateTime       @default(now())
  articleStock ArticleStock[]

  @@index([publishedAt])
  @@index([headline])
}

model ArticleStock {
  id                 String  @id @default(cuid())
  article            Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId          String
  stock              Stock   @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId            String
  sentimentScore     Float?
  // Alpha Vantage relevance for this (article, stock) pair. Persisted alongside
  // the score so the relevance-weighted sentiment blend survives the split
  // between the news stage (which writes it) and the sentiment stage (which reads it).
  sentimentRelevance Float?

  @@unique([articleId, stockId])
  @@index([stockId])
  @@index([articleId])
}

model Sentiment {
  id                 String   @id @default(cuid())
  stock              Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId            String
  score              Float
  summary            String?
  confidence         Float?
  keyDriver          String?
  aspects            Json?
  articleCount       Int      @default(0)
  avgArticleAgeHours Float?
  date               DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([stockId, date])
  @@index([date])
}

model QuantAnalysis {
  id                  String    @id @default(cuid())
  stock               Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId             String
  price               Float? // session close — every downstream calculation reads this
  // Session open, stored alongside the close from the same bar. Not used by any
  // indicator: it exists so the sim can eventually price an entry at the bar the
  // decision could actually have been acted on (a signal produced after the close can
  // only be executed at the next open), instead of at the close it was derived from.
  // Recording it now because that comparison needs history, and history has lead time.
  open                Float?
  change1d            Float?
  change7d            Float?
  change30d           Float?
  rsi14               Float?
  sma20               Float?
  sma50               Float?
  volatility30d       Float?
  volumeRatio10d      Float?
  macdHistogram       Float?
  priceVs60dHigh      Float?
  priceVs60dLow       Float?
  relativeStr7d       Float?
  bollingerWidth      Float?
  bollingerPctB       Float?
  atr14               Float?
  atrPct              Float?
  nextEarningsDate    DateTime?
  daysToEarnings      Int?
  relativeStrSector7d Float?
  score               Float
  date                DateTime  @default(now())
  // The trading session these numbers actually describe, as opposed to `date`, which is
  // the wall clock when the row was written. The two are routinely a day apart: the
  // stage runs ~02:15-02:50 UTC, so the last completed bar it can fetch belongs to the
  // previous session. Every "the price doesn't match" round-trip so far has been this
  // offset being re-derived from scratch and re-derived wrong. Nullable because rows
  // predating this column are backfilled from evidence — matching the stored close
  // against PriceBar, then promoting per-run agreement across ~100 names — which cannot
  // resolve a name with no bars (crypto, European listings, whose calendars differ
  // anyway). A null means "unknown", never "same as date"; consumers must treat it so.
  sessionDate         DateTime?
  createdAt           DateTime  @default(now())

  @@index([stockId, date])
}

// Daily OHLCV bars — the raw price record everything else is derived from.
//
// The quant stage has always fetched a 60-day window and discarded it after computing
// indicators, so the only price history the app owned was QuantAnalysis.price: one
// close per stock per day, starting the day the app first ran. That is enough to
// compute an indicator and nothing else. It cannot answer "would this order have
// filled?" — a limit order's fate is decided by the next bar's open and low, neither
// of which was kept — and it cannot support anything needing history that predates the
// app itself (a 200-day regime MA, a gap distribution with real sample size).
//
// Written forward by the quant stage from the window it already fetches, and backwards
// by scripts/backfill-price-bars.ts.
//
// Prices are SPLIT/DIVIDEND ADJUSTED, and all four of O/H/L/C must sit on the SAME
// adjustment basis. Mixing an adjusted close with a raw low fabricates a gap across
// every corporate action, which a fill model reads as a stop-out on every affected bar
// (that was a live defect in the Yahoo adapter). `source` records which adapter served
// the bar so a series written on a mixed basis can be found and rewritten later.
// Point-in-time universe membership: which stocks the pipeline intended to analyse
// on each UTC day. Written by the quant stage before any per-stock work, so a name
// whose fetch fails is still recorded as a member — this table records INTENT, not
// success (QuantAnalysis presence records success). Exists because every research
// study to date carries a survivorship caveat: the PriceBar backfill projected
// TODAY'S watchlist onto five years of history, and nothing recorded who was
// actually in the universe when. From 2026-08-24 forward, this does.
model UniverseSnapshot {
  date    DateTime // UTC midnight of the run day
  stock   Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String

  // (date, stockId) IS the identity — same reasoning as PriceBar's composite PK,
  // date-leading because "who was in the universe on day D" is the only query.
  @@id([date, stockId])
}

model PriceBar {
  stock   Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String
  date    DateTime // UTC midnight of the session date

  open   Float
  high   Float
  low    Float
  close  Float
  volume Float // Float, not Int: index and crypto volumes exceed 2^31

  source    String // "Tiingo" | "Yahoo" | "Binance" | "CoinGecko"
  createdAt DateTime @default(now())

  // (stockId, date) IS the identity, so it's the primary key — deliberately no surrogate
  // cuid `id`, unlike every other model here. This is the largest table in the schema
  // and a surrogate key would add a column plus a second unique index serving no query
  // the app makes. It also makes backfill re-runs idempotent via skipDuplicates.
  @@id([stockId, date])
  @@index([date]) // cross-sectional reads: "every bar on day D"
}

model StockEstimate {
  id                   String   @id @default(cuid())
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId              String
  sentimentScore       Float
  quantScore           Float?
  combinedScore        Float
  signal               String
  confidence           Float    @default(0.5)
  dataWarnings         String[]
  sentimentDelta       Float?
  articleVelocityRatio Float?
  date                 DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([stockId, date])
}

model Alert {
  id        String   @id @default(cuid())
  // Nullable: account/trading-health alerts (issue #56) carry no ticker.
  stock     Stock?   @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId   String?
  type      String // Stock: SIGNAL_CHANGE | VELOCITY_SPIKE | RSI_EXTREME | INSIDER_CLUSTER_BUY | INSIDER_FLOW_SHIFT | INSIDER_CSUITE_BUY. Account: ACCOUNT_DRAWDOWN | ORDER_FAILURES | BROKER_UNREACHABLE | STALE_PIPELINE
  title     String
  message   String
  value     Float?
  createdAt DateTime @default(now())

  @@index([stockId, createdAt])
  @@index([type, createdAt])
}

model EtfProfile {
  id            String    @id @default(cuid())
  stock         Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId       String    @unique
  netAssets     Float?
  expenseRatio  Float?
  dividendYield Float?
  inceptionDate DateTime?
  sectors       Json? // [{ sector, weight }]
  holdings      Json? // [{ symbol, description, weight }]
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

// Raw normalized insider transactions (one row per filed Form 4 transaction line).
// US-equity only; populated from Finnhub /stock/insider-transactions.
model InsiderTransaction {
  id      String @id @default(cuid())
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String

  insiderName     String
  // Insider role/relationship — only populated by the EDGAR source (Finnhub omits it).
  officerTitle    String?
  isOfficer       Boolean @default(false)
  isDirector      Boolean @default(false)
  isTenPctOwner   Boolean @default(false)
  transactionCode String // raw SEC code: P, S, A, M, F, G, C, X...
  txnType         String // normalized: OPEN_MARKET_BUY | OPEN_MARKET_SELL | GRANT | OPTION_EXERCISE | TAX_WITHHOLDING | GIFT | CONVERSION | OTHER
  isPlanned       Boolean @default(false) // 10b5-1 (from EDGAR aff10b5One)
  isDerivative    Boolean @default(false)

  shares         Float // signed: + acquired, - disposed
  price          Float? // per-share transaction price
  value          Float? // |shares| * price (notional)
  sharesAfter    Float? // holdings after the transaction
  pctHoldingsChg Float? // |shares| / prior holdings, when computable

  transactionDate DateTime
  filingDate      DateTime
  accessionId     String? // SEC filing accession number, when provided

  // Stable identity key so overlapping re-fetch windows upsert as no-ops.
  // Value-inclusive, so distinct lines never collapse; an amendment that restates
  // shares/price lands as a new row (the summary uses the latest filingDate).
  dedupKey String @unique

  createdAt DateTime @default(now())

  @@index([stockId, transactionDate])
  @@index([stockId, filingDate])
}

// Per-stock, per-day derived rollup — mirrors QuantAnalysis. Detectors read the
// latest row vs the previous one (transition detection); the page reads history.
model InsiderSummary {
  id      String @id @default(cuid())
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String

  // Trailing 90-day open-market aggregates (noise codes excluded).
  buyCount90d        Int   @default(0)
  sellCount90d       Int   @default(0)
  distinctBuyers90d  Int   @default(0)
  distinctSellers90d Int   @default(0)
  netShares90d       Float @default(0) // signed open-market net shares
  netValue90d        Float @default(0) // signed open-market net notional
  buyValue90d        Float @default(0)
  sellValue90d       Float @default(0)

  // 14-day cluster window.
  distinctBuyers14d Int   @default(0)
  csuiteBuyValue14d Float @default(0) // open-market CEO/CFO/COO/Chair buys (EDGAR roles)

  mspr            Float? // Finnhub monthly share purchase ratio (latest month)
  convictionScore Float  @default(0) // combined -1..1
  signals         Json? // [{ type, detail, value }] fired this run

  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([stockId, date])
}

// US congressional trading (STOCK Act disclosures), sourced from the AInvest
// developer API (per-ticker, /ownership/congress). Engagement feature, not a fast
// signal — the STOCK Act permits up to a 45-day disclosure lag, so rows are
// ingested daily on the insider workflow. Only watched tickers are persisted.
// AInvest reports party + state (not chamber); owner/ptrLink are kept nullable
// for a future richer source and stay null today.
model CongressTrade {
  id              String   @id @default(cuid())
  stock           Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId         String
  politician      String
  party           String? // Democrat | Republican | Independent (AInvest `party`)
  state           String? // US state abbreviation (AInvest `state`)
  owner           String? // self | spouse | joint | child — not supplied by AInvest
  txnType         String // PURCHASE | SALE | EXCHANGE | OTHER
  amountRange     String // verbatim range string, e.g. "$100K-$250K"
  transactionDate DateTime
  disclosureDate  DateTime
  ptrLink         String? // disclosure link; persisted only if http(s) — not supplied by AInvest
  // Value-inclusive identity key so overlapping re-fetch windows upsert as no-ops.
  dedupKey        String   @unique
  createdAt       DateTime @default(now())

  @@index([stockId, transactionDate])
}

// Signal-performance tracking (issue #14). The app acts on its own daily signals
// with simulated trades and tracks hypothetical P&L per signal source, answering
// "how predictive are our signals — and which source (sentiment / quant / the
// combined estimate) leads?". Long-only, US-equity only, confidence-weighted
// sizing, daily and idempotent per UTC day (rides pipeline.yml after `estimate`).

// Audit log of REAL orders placed on the Alpaca paper account for the COMBINED
// book, with fill reconciliation. The Alpaca book is the credible, fills-included
// proof; the SimPosition books below are the apples-to-apples per-signal compare.
model PaperOrder {
  id      String @id @default(cuid())
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String

  side           String // BUY | SELL
  signal         String // scoreToSignal label that triggered the order (combined book)
  notional       Float? // requested notional ($) — set on confidence-weighted buys
  qty            Float? // requested quantity — set on sell-to-close
  alpacaOrderId  String? @unique // Alpaca order id; null while the intent is unsubmitted
  // Idempotency key, assigned and PERSISTED BEFORE the order is submitted, and sent to
  // Alpaca as client_order_id. Two jobs: (1) a crash between "broker accepted" and
  // "row written" leaves a recoverable intent — the next run looks the order up by this
  // id and adopts it, instead of the order existing only at the broker; (2) Alpaca
  // rejects a duplicate client_order_id, so a retry cannot double-submit. Null on rows
  // predating durable intents, and on protective legs (which arrive with their OTO
  // parent and so cannot be independently duplicated).
  clientOrderId  String? @unique
  status         String // PENDING_SUBMIT (intent, not yet at the broker) | ABANDONED | Alpaca status
  filledQty      Float?
  filledAvgPrice Float?
  submittedAt    DateTime @default(now())
  filledAt       DateTime?

  @@index([stockId, submittedAt])
  @@index([status]) // the pending-submit recovery sweep
}

// Mutual exclusion for a pipeline stage. Distinct from the per-day idempotency marker
// (the SIM_COMBINED PaperEquitySnapshot row), and the two must not be merged: the
// MARKER is written LAST so a run that crashes half-way is retried rather than skipped,
// while a LEASE must be taken FIRST or it excludes nothing. Taking the marker first
// would fix the race and break crash-retry.
//
// Needed because the paper stage has two schedulers deliberately aligned on the same
// minute: GH Actions (`30 19` / `30 20` weekdays) and the Supabase pg_cron tick
// (`*/5 16-21` weekdays). The old guard was read-then-act, so both could see "not run"
// and both submit broker orders.
//
// Acquired with a single atomic upsert that only steals an EXPIRED lease (see
// lib/pipeline-lease.ts) — the expiry is what stops a crashed run from blocking the
// stage forever.
model PipelineLease {
  stage      String   @id // "paper" | ... — one row per stage
  holder     String // opaque per-run id, so only the holder can release it
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
}

// Internal mark-to-market position per (stock, strategy). At most one OPEN row per
// pair. Sizing uses the estimate's confidence for every strategy (held constant),
// so only the *signal* differs between books — an apples-to-apples comparison of
// which signal source picks better. Runs even without Alpaca keys.
model SimPosition {
  id      String @id @default(cuid())
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String

  strategy     String // SENTIMENT | QUANT | COMBINED (+ *_RM risk-managed variants)
  status       String // OPEN | CLOSED
  qty          Float
  entryDate    DateTime
  entryPrice   Float
  confidence   Float
  lastMarkDate DateTime
  lastMarkPrice Float?
  exitDate     DateTime?
  exitPrice    Float?
  realizedPnl  Float?

  // Why the trade happened. The reconcilers compute all three and the daily review
  // audits against them; before they existed the reason was discarded, so rows
  // predating this are null and the review treats null as "pre-instrumentation".
  entrySignal String? // scoreToSignal label at entry (BUY | STRONG_BUY)
  entryScore  Float? // this strategy's source score at entry (drives the decay audit)
  exitReason  String? // STOP | TRAIL | SIGNAL | DECAY | TIME | HOLD_EXPIRY

  // Risk-managed (_RM) overlay state; null/0 on the pure books that don't use it.
  peakPrice     Float? // running max since entry — drives the trailing stop
  bearishStreak Int    @default(0) // consecutive bearish runs — confirmed-signal exit
  staleStreak   Int    @default(0) // consecutive no-conviction runs — signal-decay exit
  entryAtrPct   Float? // ATR% captured at entry — freezes the stop/trail distances

  createdAt DateTime @default(now())

  @@index([strategy, status])
  @@index([stockId, strategy])
  // NOTE: the "at most one OPEN row per (stock, strategy)" invariant in the comment
  // above is enforced by a PARTIAL unique index — `("stockId", strategy) WHERE status =
  // 'OPEN'` — created in raw SQL (see the add_pipeline_lease migration). Prisma cannot
  // express a partial index, so it does NOT appear here. A plain @@unique would be
  // wrong: it forbids ever re-entering a name after closing it.
}

// Daily equity point per book — drives the performance equity curves and the
// summary cards. One row per (book, UTC-day); the per-day SIM_COMBINED row is also
// the stage's idempotency guard. Sim equity = starting + Σrealized + Σunrealized
// (unconstrained by cash — it measures signal quality, not capital allocation);
// the ALPACA row comes straight from the paper account.
model PaperEquitySnapshot {
  id             String   @id @default(cuid())
  book           String // ALPACA | SIM_SENTIMENT | SIM_QUANT | SIM_COMBINED
  date           DateTime
  equity         Float
  cash           Float?
  realizedPnl    Float    @default(0)
  unrealizedPnl  Float    @default(0)
  openPositions  Int      @default(0)
  // Cost basis of the positions open at this snapshot — the capital actually at work.
  // Recorded per day so a book's return can be measured against the money that earned
  // it rather than against SIM_STARTING_EQUITY, which never constrains anything. Null
  // on the ALPACA book (its deployed capital lives at the broker, not in SimPosition)
  // and on rows written before this column existed.
  deployed       Float?
  createdAt      DateTime @default(now())

  @@unique([book, date])
}

model UserStock {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String

  @@unique([userId, stockId])
  @@index([stockId])
}

model UserMarket {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  marketId String

  @@unique([userId, marketId])
  @@index([marketId])
}

// Global, app-wide settings as a key/value store (admin-editable at runtime).
// Currently holds `watchlistLimit`; new singleton settings can reuse this table.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Daily snapshot of the signal-calibration harness (issue #55). One row per UTC
// day (the `calibrate` stage upserts it — idempotent like the other stages). A few
// columns are promoted for querying gate-status history / alerts; the full report
// is kept as JSON so the admin page can render a past day without recomputing.
// ── Private-company news watch (issue #63) ─────────────────────────────────
// Deliberately isolated from the public Stock/ArticleStock universe: private
// companies have no tickers, prices, signals, alerts, or trading. The canonical
// company list lives in code (lib/private-companies.ts) and is synced here
// idempotently by the pipeline stage; rows dropped from the seed go inactive
// rather than being deleted, preserving their article history.
model PrivateCompany {
  id        String                  @id @default(cuid())
  slug      String                  @unique // stable key for the code-side seed sync
  name      String
  query     String? // Google News query override for ambiguous names (null → derived from name)
  active    Boolean                 @default(true)
  createdAt DateTime                @default(now())
  articles  PrivateCompanyArticle[]
}

model PrivateCompanyArticle {
  id          String         @id @default(cuid())
  company     PrivateCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  headline    String
  url         String
  source      String
  publishedAt DateTime
  createdAt   DateTime       @default(now())

  // Same article may cover two watched companies — dedupe per company, not globally.
  @@unique([companyId, url])
  @@index([companyId, publishedAt])
}

model CalibrationSnapshot {
  id             String   @id @default(cuid())
  date           DateTime // UTC day
  gateStatus     String // GO | NO_GO | INSUFFICIENT_DATA
  gatedBook      String
  monthsCoverage Float
  closedTrades   Int
  edgeMean       Float?
  edgeTStat      Float?
  alphaTStat     Float?
  combinedIc     Float? // combined-score IC at the gate horizon
  report         Json // full CalibrationReport
  createdAt      DateTime @default(now())

  @@unique([date])
}

// Daily post-close self-audit — "did the app do what its own rules say it should?".
// One row per UTC trading day, written by two stages an hour apart:
//   • the paper stage appends `paperRun` — the decision log for its run (the exact
//     inputs each (stock, strategy) was judged on, plus the action taken). Without
//     it the review can only infer intent from the mutated end state; with it the
//     pure reconcilers can be replayed against identical inputs and diffed.
//   • the review stage fills `report` — the findings, plus the health/tuning rollups.
// `status` and `findingCount` are denormalized out of `report` so the dashboard and
// the report API can list days without deserializing every payload.
model DailyReview {
  id           String   @id @default(cuid())
  date         DateTime // start of UTC day
  paperRun     Json? // PaperRunLog — written by the paper stage
  report       Json? // DailyReviewReport — written by the review stage
  status       String? // OK | WARN | FAIL
  findingCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([date])
}
