# Copy to .env and fill in. Values here are placeholders, not real secrets.

# ── Database (Supabase Postgres via Prisma) ──────────────────────────────────
# Transaction mode (port 6543) for runtime queries; session mode (5432) for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Clerk auth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Public app URL ───────────────────────────────────────────────────────────
# Where invitees are sent after clicking a Clerk invitation email. Resolution order
# is APP_URL → NEXT_PUBLIC_APP_URL → VERCEL_URL (auto-set on Vercel) → the request
# origin. Set one locally, or invitations opened on another machine point at your
# localhost. No trailing slash needed — it's stripped.
# APP_URL=https://your-app.vercel.app
# NEXT_PUBLIC_APP_URL=

# ── LLM sentiment (OpenRouter, despite the VLLM_ names) ──────────────────────
LLM_API_KEY=sk-or-v1-xxx
VLLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
VLLM_URL=https://openrouter.ai/api/v1

# ── Data source API keys ─────────────────────────────────────────────────────
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
ALPHAVANTAGE_API_KEY=
TIINGO_API_KEY=
COINGECKO_API_KEY=
# Tiingo News is paid; gate it on explicitly.
# TIINGO_NEWS=1
# Alpaca News (Benzinga-sourced, US equities). Free on the Basic plan; both keys
# required or the source is a clean no-op. https://app.alpaca.markets/ → API keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Alpaca PAPER trading (signal-performance tracking, #14). ONE operator-owned paper
# account (not per-user) — these back a single shared book and the admin-only
# /dashboard/performance view. SEPARATE key pair from the News keys above: mint them
# on the paper account (https://app.alpaca.markets/ → switch to Paper → API keys).
# Both required, or the Alpaca book no-ops and only the internal sim books run (the
# sim books need no keys at all).
ALPACA_PAPER_API_KEY_ID=
ALPACA_PAPER_API_SECRET_KEY=
# Endpoint override, for pointing the client at a test stub. Deliberately NOT an
# escape hatch to live trading: baseUrl() rejects any *.alpaca.markets host that
# isn't paper-api.alpaca.markets, so going live must be a reviewed code change.
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# Optional sizing knobs: base $ per signal before the confidence weight (default
# 1000; PURE books only — _RM/live books use PAPER_RISK_PER_TRADE below) and the
# notional bankroll the sim books are measured against (default 100000).
# PAPER_BASE_NOTIONAL=1000
# PAPER_SIM_STARTING_EQUITY=100000
# Risk-managed books (#14 follow-up): when =1, run the *_RM sim variants (signal +
# a price-aware exit overlay) AND point the live Alpaca book at the risk-managed
# combined signal. Unset/!=1 = pure signal-only books only (status quo). The pure
# books always run regardless, as the clean attribution baseline.
# PAPER_RISK_BOOKS=1
# NOTE: the numeric strategy knobs (stop/trail distances, ATR scaling, exit-run
# counts, entry gates, risk-per-trade sizing, portfolio caps, kill-switch levels)
# are NOT env vars anymore — they live in the DB (AppSetting "tradingConfig") and
# are edited on the admin page (/dashboard/admin → Trading strategy), with code
# defaults as fallback. The old PAPER_* knob env vars still work as break-glass
# overrides that beat the DB value; see src/lib/trading-config.ts for the full
# list, defaults, and bounds.
# Portfolio-level risk limits (#56): when =1, gate fresh _RM/live buys behind
# book-level caps + a drawdown kill-switch. Unset/!=1 = caps off (status quo).
# PAPER_RISK_LIMITS=1
# Insider event book (#57): when =1, run the SIM_INSIDER attribution book — enter
# on insider cluster-buy / C-suite-buy alerts, hold a fixed multi-week period
# (knobs in the DB admin config), exit on expiry. Sim-only, no live orders.
# PAPER_INSIDER_BOOK=1
# Confidence recalibration: when =1 (with PAPER_RISK_BOOKS=1), the _RM + live books
# size/enter with confidence adjusted by the calibration harness's reliability
# diagram (how each stated-confidence bucket actually performed). Self-disables
# until the data is trustworthy (min sample + Brier beats base rate). Pure books
# always keep raw confidence.
# PAPER_CONF_CALIBRATION=1
# PAPER_STALE_DATA_HOURS=48         # stale-pipeline alert threshold (freshest estimate age)
# Broker-enforced stops (panel follow-up): when =1 (with PAPER_RISK_BOOKS=1 + paper
# keys), the live Alpaca book switches to WHOLE-SHARE entries with native GTC
# stop-loss / trailing-stop orders — the broker enforces protective exits
# continuously (intraday, gap-aware) instead of once/day. Whole-share sizing means a
# name is skipped live when the risk-sized budget is under one share (the sim books
# still cover it). Unset/!=1 = the original notional-mirror behavior.
# PAPER_BROKER_STOPS=1
# PAPER_ENTRY_LIMIT_BUFFER_PCT=0.02   # marketable-limit buffer for broker entries (fills like market, allows GTC).
#   Also a filter on gap direction: the order fills when a name gaps DOWN and fails when
#   it gaps UP past the buffer, and gapping up is what winners do — at 0.5%, eight of
#   nine entries that never filled were winners. Widening reduces that selection, but the
#   OTO stop is priced off the same reference close and cannot know the fill, so a
#   top-of-band fill sits (buffer + stopPct) from its stop while sizing assumed stopPct.
#   planBrokerAction re-anchors the stop once the fill is known; keep this modest anyway.
# PAPER_STOP_REANCHOR_TOLERANCE_PCT=0.005  # drift before a mis-anchored fixed stop is re-placed
# PAPER_ENTRY_ORDER_TTL_DAYS=1        # days an UNFILLED buy entry may rest before it is cancelled.
#   Entries go in GTC so the attached stop survives the close, and nothing used to cancel
#   them — nine were found resting 28-33 days, still able to fill on a month-old signal.
#   1 = an order gets its next session and no more. SELLs are never expired. 0 disables.
# Near-close trade window: when =1 the paper stage only acts in the final minutes
# before the US close (deep liquidity; close-aligned marks). Uses the Alpaca clock
# when paper keys are set, else a static UTC weekday window. Pair with the near-close
# cron entries in .github/workflows/pipeline.yml.
# PAPER_TRADE_NEAR_CLOSE=1
# PAPER_TRADE_WINDOW_MIN=30          # how many minutes before the close count as "near"
# Live intraday pricing: when =1 AND the session is open, the paper stage prices every
# decision, simulated fill, limit reference and mark off the last TRADE instead of the
# last stored close. This is what makes sim and broker P&L comparable at all — booking a
# simulated fill at a close the broker can only fill after measures an event that never
# happened. Reuses the MARKET DATA keys above (ALPACA_API_KEY_ID/_SECRET), not the paper
# trading keys; no new credentials needed. Only does anything in-hours, so it is inert
# unless PAPER_TRADE_NEAR_CLOSE=1 puts a run inside the session.
# PAPER_LIVE_QUOTES=1
# Stage mutual exclusion (lib/pipeline-lease.ts). Must exceed the longest plausible run —
# a lease expiring mid-run lets a second invocation in — while staying short enough that
# a crashed run does not block the stage all day. Stage budget is 240s (below).
# PIPELINE_LEASE_TTL_SECONDS=900

# ── Pipeline pacing ──────────────────────────────────────────────────────────
# How much work a stage attempts per invocation. Stages are resumable, so lowering
# these makes runs shorter and more numerous, not less complete. Raise the
# concurrencies only if the upstream API tolerates it — most rate-limit hard.
# PIPELINE_STAGE_BUDGET_MS=240000     # wall-clock a stage may use before yielding to the
#   next call. Must stay under the 300s serverless function timeout, with margin for the
#   final DB writes; a stage that overruns is killed mid-write, not resumed cleanly.
# PIPELINE_NEWS_CHUNK=25              # tickers per news slice
# PIPELINE_SENTIMENT_CONCURRENCY=3    # parallel LLM calls (cost + provider limits)
# PIPELINE_QUANT_CONCURRENCY=3        # parallel price-history fetches
# PIPELINE_ESTIMATE_CONCURRENCY=5     # DB-only, so the cheapest to raise
# PIPELINE_INSIDER_CONCURRENCY=2      # Finnhub + SEC EDGAR; EDGAR is strict about pace

# ── Daily post-close review ──────────────────────────────────────────────────
# A self-audit that runs ~1h after the close and asks whether the app did what its
# own rules say it should have done (replayed decisions, exit-rung invariants,
# broker reconciliation, pipeline health) — then emails admins and publishes to
# /dashboard/review. No flag to enable: it runs wherever it's triggered from
# (pg_cron job `daily-review-tick`, plus .github/workflows/review.yml as backup),
# and self-gates to the post-close window using the broker calendar so it lands an
# hour after the ACTUAL close, early-close days included.
# REVIEW_WINDOW_FROM_MIN=55           # window opens this many minutes after the close
# REVIEW_WINDOW_TO_MIN=115            # ...and shuts this many minutes after it
# REVIEW_TUNING_LOOKBACK_DAYS=90      # trailing window for the per-book exit-rung stats
# REVIEW_TRACKING_MIN_COVERAGE=0.7    # fraction of live positions that must reconcile to
#   the sim before the run counts as tracking; below it, the review flags the divergence.
#
# Slack + LLM interpretation of the findings. The interpret step is gated ENTIRELY on
# SLACK_WEBHOOK_URL: unset = the review still computes and emails, it just isn't
# summarized or posted. Also what improve.yml reads before opening a fix PR.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# REVIEW_LLM_MODEL=                   # optional stronger model for the interpretation;
#   unset falls back to VLLM_MODEL. Shares LLM_API_KEY / VLLM_URL with sentiment.

# ── Pipeline auth (called by GitHub Actions) ─────────────────────────────────
CRON_SECRET=
PIPELINE_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# BOTH are required — isEmailConfigured() checks for each, so with only the API key
# every send is a silent no-op and alert/review emails simply never arrive.
# No domain? Use ALERT_FROM_EMAIL=onboarding@resend.dev — Resend's shared sender,
# which needs no DNS but can ONLY deliver to the address that owns the Resend
# account. Fine while you're the only recipient; sending to anyone else requires a
# from-address on a domain verified in Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# ── SEC EDGAR insider source ─────────────────────────────────────────────────
INSIDER_EDGAR=1
SEC_USER_AGENT=TraderNews-insider/1.0 (you@example.com)
# Optional pacing / window for the insider stage.
# INSIDER_BACKFILL_DAYS=90            # trailing window of Form 4 activity fetched each run
# INSIDER_EDGAR_MAX_FILINGS=80        # cap on filings pulled per issuer before EDGAR
#   throttles; the SEC enforces politeness, so raise this cautiously.

# ── Congress trading (AInvest /ownership/congress) ───────────────────────────
# Free tier, no card. Key from https://www.ainvest.com/business/developer-manage/
# Unset = the congress stage is a clean no-op. Runs on the insider workflow.
AINVEST_API_KEY=
# Optional: trailing window fetched each run (default 180; STOCK Act lag is ~45d).
# CONGRESS_BACKFILL_DAYS=180
# Free-tier pacing (defaults are conservative for the throttled free plan):
# PIPELINE_CONGRESS_CONCURRENCY=1     # serial; raise only on a paid AInvest plan
# CONGRESS_REQUEST_SPACING_MS=1000    # gap between requests
# CONGRESS_RATE_LIMIT_BACKOFF_MS=1000 # base backoff when throttled (status 4014)
# AINVEST_BASE_URL=https://openapi.ainvest.com/open   # endpoint override (test stubs)

# ── Observability (all optional; unset = Sentry disabled, logs to stdout only) ─
# Sentry error tracking — server reads SENTRY_DSN, browser reads NEXT_PUBLIC copy.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload (optional). No token = upload skipped, build still works.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Axiom structured logging — both required to ship logs.
AXIOM_TOKEN=
AXIOM_DATASET=
# Region endpoint. Default (unset) = US (api.axiom.co). For an EU dataset/org set:
# AXIOM_URL=https://api.eu.axiom.co  (token must be from the same region as the dataset)
AXIOM_URL=
# Optional min log level: debug|info|warn|error (default info; silent in tests).
LOG_LEVEL=

# ── Rate limiting (Upstash Redis, #19) ───────────────────────────────────────
# Per-user sliding-window limits on the search + mutation routes. Unset = the
# limiter no-ops (rate limiting OFF) — fine for local/CI and a few trusted users,
# but set these before opening signups. Provision an Upstash Redis (Vercel
# Marketplace → Upstash, free tier) and paste its REST URL + token.
# NOTE: if you provision via the Vercel Upstash integration, you don't need to set
# these — the app auto-detects the integration's *_KV_REST_API_URL / *_KV_REST_API_TOKEN
# vars (any prefix). Set the two below only for a manual / non-Vercel deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Tests ────────────────────────────────────────────────────────────────────
# Where Playwright points. Unset = the local dev server started by playwright.config.ts.
# E2E_BASE_URL=http://localhost:3000
